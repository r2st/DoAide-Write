[Unit]
Description=DoAide Write Web (write.doaide.com)
After=network.target

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/opt/doaide-write
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
EnvironmentFile=/opt/doaide-write/.env

[Install]
WantedBy=multi-user.target
